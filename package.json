{
  "name": "makro-scoring-regime-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Makro-Scoring & Regime-Check — 9 Whitelist-Indikatoren, 3 Faktoren, 1 Score, mit Wochen-Historie",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "update": "tsx src/cli/update.ts",
    "backfill": "tsx src/cli/backfill.ts",
    "check:sources": "tsx src/cli/check-sources.ts",
    "server": "tsx src/server/index.ts",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:server\" \"npm:web\"",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "express": "^5.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
